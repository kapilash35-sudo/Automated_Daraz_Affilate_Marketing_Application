# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=whatsapp_marketing
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_marketing?schema=public"

# Redis & Queue Configuration
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# MinIO S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=whatsapp-media
MINIO_PUBLIC_URL=http://localhost:9000/whatsapp-media

# WAHA (WhatsApp HTTP API)
WAHA_PORT=3005
WAHA_BASE_URL=http://localhost:3005
WAHA_SESSION=default

# Google Gemini API
# Acquire from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Backend Application
BACKEND_PORT=4000
HOST=0.0.0.0
BASE_REDIRECT_URL=http://localhost:4000
DAILY_NEWS_LIMIT=50
DISPATCH_DELAY_MS=30000

# Frontend Next.js Application
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

