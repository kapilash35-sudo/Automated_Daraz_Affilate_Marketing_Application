generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  SOURCE
  DESTINATION
  NONE
}

enum ChannelType {
  NEWS
  DARAZ
}

enum GroupLanguage {
  TAMIL
  SINHALA
  ALL
}

enum PostStatus {
  PENDING
  PENDING_APPROVAL
  PROCESSING
  SENT
  REJECTED
  DUPLICATE
  FAILED
}

enum EngagementType {
  REACTION
  CLICK
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Group {
  id         String        @id @default(cuid())
  wahaChatId String        @unique
  name       String
  role       GroupRole     @default(NONE)
  type       ChannelType   @default(DARAZ)
  language   GroupLanguage @default(TAMIL)
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  destinationPosts Post[] @relation("DestinationGroupPosts")

  @@index([role, type, language, isActive])
}

model Post {
  id                   String         @id @default(cuid())
  sourceRef            String?
  destinationGroupId   String?
  destinationGroup     Group?         @relation("DestinationGroupPosts", fields: [destinationGroupId], references: [id], onDelete: SetNull)
  type                 ChannelType    @default(DARAZ)
  rawPayload           Json
  processedText        String?        @db.Text
  processedTextSinhala String?        @db.Text
  mediaUrl             String?
  status               PostStatus     @default(PENDING_APPROVAL)
  duplicateReason    String?
  wahaMessageId      String?        @unique
  pollMessageId      String?        @unique
  sentAt             DateTime?
  clicksCount        Int            @default(0)
  reactionsCount     Int            @default(0)
  ordersCount        Int            @default(0)
  actualRevenue      Float          @default(0)
  actualCommission   Float          @default(0)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  engagements        Engagement[]
  darazOrders        DarazOrder[]

  @@index([status, type, createdAt])
  @@index([sentAt])
  @@index([pollMessageId])
}

model Engagement {
  id         String         @id @default(cuid())
  postId     String
  post       Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  type       EngagementType
  recordedAt DateTime       @default(now())
  metadata   Json?

  @@index([postId, type])
  @@index([type, recordedAt])
}

model DarazOrder {
  id               String   @id @default(cuid())
  orderId          String   @unique
  subOrderId       String?  // {_p_sub_transaction}
  subAffId         String?  // {sub_aff_id}
  subId            String?  // {sub_id1}
  postId           String?
  post             Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  language         String?  // {sub_id2} TAMIL / SINHALA
  itemId           String?  // {_p_purchased_item_id}
  sku              String?  // {_p_sku_daraz}
  itemName         String?
  category1        String?  // {_p_cate_name_lv1}
  category2        String?  // {_p_cate_name_lv2}
  deviceOs         String?  // {_device_os}
  platform         String?  // {_p_platform}
  isNewUser        Boolean? @default(false) // {_p_new_user}
  commissionRate   Float?   @default(0) // {_p_com_rate}
  orderAmount      Float    @default(0) // {_p_pay_amount}
  commissionAmount Float    @default(0) // {_p_payout}
  currency         String   @default("LKR")
  status           String   @default("Order") // {_p_status}
  eventTime        DateTime @default(now())
  rawPayload       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orderId])
  @@index([postId])
  @@index([status])
  @@index([language])
  @@index([createdAt])
}

